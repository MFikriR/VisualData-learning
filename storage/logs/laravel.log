                                                <div class=\"os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500\" style=\"bottom: 10%; left: 10%;\" data-color=\"bg-red-500\"></div>
