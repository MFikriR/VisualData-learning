                                            <div id="osSuccessMsg" class="hidden mt-6 bg-blue-50 border border-blue-300 p-3 rounded-xl text-center w-full max-w-[300px] animate-fade-in">
                                                <strong class="text-blue-800 text-sm block mb-1">Aha! Cluster Terbentuk 🌸</strong>
