                <script>
                    // Inisialisasi Kerumunan Data Normal
                    const radarCanvas = document.getElementById('radarCanvas');
                    const maxX = 20; // 20 Tahun
                    const maxY = 60; // 60 Juta
                    
                    // Titik kerumunan normal (biru)
                    const normalPoints = [
                        [2, 12], [3, 14], [4, 15], [5, 18], [5, 15], [6, 20], [7, 22], [8, 25], 
                        [9, 26], [10, 30], [10, 24], [11, 28], [12, 32], [13, 30], [14, 35], [15, 34], 
                        [16, 38], [18, 40], [3, 11], [6, 17], [8, 21], [11, 31], [14, 29]
                    ];

                    function drawBasePoints() {
                        radarCanvas.innerHTML = ''; // Bersihkan canvas
                        normalPoints.forEach(function(pt) {
                            let dot = document.createElement('div');
                            dot.className = 'absolute w-3 h-3 bg-blue-600 rounded-full shadow-sm';
                            // Kalkulasi posisi (PHP safe concatenation)
                            dot.style.left = (pt[0] / maxX * 100) + '%';
                            dot.style.bottom = (pt[1] / maxY * 100) + '%';
                            radarCanvas.appendChild(dot);
                        });
                    }

                    function plotNewData() {
                        let x = parseFloat(document.getElementById('inputX').value);
                        let y = parseFloat(document.getElementById('inputY').value);
                        let resBox = document.getElementById('radarResult');

                        if (isNaN(x) || isNaN(y) || x < 0 || y < 0) {
                            resBox.className = \"mt-4 p-3 rounded-xl border border-yellow-500 bg-yellow-900/30 text-yellow-400 text-center font-bold text-xs animate-pulse\";
                            resBox.innerText = \"⚠️ Masukkan angka yang valid!\";
                            resBox.classList.remove('hidden');
                            return;
                        }

                        // Batasi nilai agar tidak keluar dari canvas
                        if(x > maxX) x = maxX;
                        if(y > maxY) y = maxY;

                        drawBasePoints(); // Redraw dasar agar titik uji sebelumnya hilang

                        let newDot = document.createElement('div');
                        
                        // Logika sederhana deteksi anomali:
                        // Gaji wajar secara kasar adalah: Pengalaman * 2 + 10 (+/- 10 juta toleransi)
                        let expectedMin = (x * 1.5) + 5;
                        let expectedMax = (x * 2.5) + 15;
                        
                        let isOutlier = false;
                        if (y > expectedMax || y < expectedMin) {
                            isOutlier = true;
                        }

                        // Jika gaji sangat tinggi tapi pengalaman sangat rendah (Anak Pemilik)
                        if (x <= 3 && y >= 40) isOutlier = true;

                        if (isOutlier) {
                            newDot.className = 'absolute w-4 h-4 bg-red-500 rounded-full border-2 border-white shadow-[0_0_15px_rgba(239,68,68,1)] z-20 animate-bounce';
                            resBox.className = \"mt-4 p-3 rounded-xl border border-red-500 bg-red-900/30 text-red-400 text-center font-bold text-sm shadow-inner\";
                            resBox.innerHTML = \"🚨 OUTLIER TERDETEKSI!<br><span class='text-xs font-normal text-gray-300'>Data terasing dari kerumunan.</span>\";
                        } else {
                            newDot.className = 'absolute w-4 h-4 bg-green-500 rounded-full border-2 border-white shadow-[0_0_15px_rgba(34,197,94,1)] z-20 animate-pulse';
                            resBox.className = \"mt-4 p-3 rounded-xl border border-green-500 bg-green-900/30 text-green-400 text-center font-bold text-sm shadow-inner\";
                            resBox.innerHTML = \"✅ DATA NORMAL<br><span class='text-xs font-normal text-gray-300'>Masuk dalam kerumunan.</span>\";
                        }

                        newDot.style.left = (x / maxX * 100) + '%';
                        newDot.style.bottom = (y / maxY * 100) + '%';
                        radarCanvas.appendChild(newDot);
                        resBox.classList.remove('hidden');
                    }

                    // Inisialisasi saat dimuat
                    document.addEventListener('DOMContentLoaded', drawBasePoints);
                </script>


