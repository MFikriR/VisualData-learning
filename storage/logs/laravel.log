                <script>
                    function updateBar() {
                        let a = parseInt(document.getElementById("valA").value) || 0;
                        let b = parseInt(document.getElementById("valB").value) || 0;
                        let c = parseInt(document.getElementById("valC").value) || 0;
                        let d = parseInt(document.getElementById("valD").value) || 0;
                        
                        document.getElementById("barA").style.height = (a / 10) + "px";
                        document.getElementById("barB").style.height = (b / 10) + "px";
                        document.getElementById("barC").style.height = (c / 10) + "px";
                        document.getElementById("barD").style.height = (d / 10) + "px";

                        document.getElementById("labelA").innerText = a;
                        document.getElementById("labelB").innerText = b;
                        document.getElementById("labelC").innerText = c;
                        document.getElementById("labelD").innerText = d;
                    }

                    function checkAnswer(isCorrect, explanation) {
                        if(isCorrect) {
