                                                <div class=\"os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500\" style=\"bottom: 12%; left: 22%;\" data-color=\"bg-red-500\"></div>
                                                <div class=\"os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500\" style=\"bottom: 18%; left: 15%;\" data-color=\"bg-red-500\"></div>

                                                <div class=\"os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500\" style=\"bottom: 45%; left: 45%;\" data-color=\"bg-green-500\"></div>
