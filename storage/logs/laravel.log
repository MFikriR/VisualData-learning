                                                <div class="os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500" style="bottom: 75%; left: 75%;" data-color="bg-blue-500"></div>
                                                <div class="os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500" style="bottom: 82%; left: 82%;" data-color="bg-blue-500"></div>
                                                <div class="os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500" style="bottom: 78%; left: 88%;" data-color="bg-blue-500"></div>
                                                <div class="os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500" style="bottom: 85%; left: 78%;" data-color="bg-blue-500"></div>
                                                <div class="os-dot absolute w-2.5 h-2.5 rounded-full border border-white shadow-sm bg-gray-500 transition-colors duration-500" style="bottom: 72%; left: 92%;" data-color="bg-blue-500"></div>

                                                <div class="absolute h-0.5 bg-gray-400 w-[120%] bottom-0 left-0 transform origin-bottom-left -rotate-30 opacity-30 border-dashed border-t"></div>
