                <script>
                    let osStep = 1;

                    function osAddFile() {
                        if(osStep !== 1) return;
                        
                        document.getElementById('osNodeFile').classList.remove('scale-0');
                        document.getElementById('osNodeFile').classList.add('scale-100');
                        
                        let btnFile = document.getElementById('osBtnFile');
                        btnFile.classList.add('bg-gray-600', 'text-gray-400', 'border-gray-700', 'opacity-50', 'cursor-not-allowed', 'shadow-none');
                        btnFile.classList.remove('bg-white', 'text-black', 'border-gray-300', 'shadow-[0_4px_0px_#cbd5e1]', 'active:translate-y-1');
                        
                        let btnBar = document.getElementById('osBtnScatter');
                        btnBar.classList.remove('bg-gray-600', 'text-gray-400', 'border-gray-700', 'opacity-50', 'cursor-not-allowed', 'disabled');
                        btnBar.classList.add('bg-gradient-to-r', 'from-blue-500', 'to-indigo-600', 'text-white', 'border-blue-300', 'shadow-[0_4px_0px_#4f46e5]', 'active:shadow-none', 'active:translate-y-1', 'cursor-pointer');
                        btnBar.removeAttribute('disabled');

                        document.getElementById('osInstruction').innerHTML = '2. Bagus! Dataset Iris dimuat. Sekarang tambahkan <span class="text-blue-400">Scatter Plot</span>.';
                        osStep = 2;
                    }

                    function osAddScatter() {
                        if(osStep !== 2) return;
                        
                        document.getElementById('osNodeScatter').classList.remove('scale-0');
                        document.getElementById('osNodeScatter').classList.add('scale-100');
                        
                        let btnBar = document.getElementById('osBtnScatter');
                        btnBar.classList.add('bg-gray-600', 'text-gray-400', 'border-gray-700', 'opacity-50', 'cursor-not-allowed', 'shadow-none');
                        btnBar.classList.remove('bg-gradient-to-r', 'from-blue-500', 'to-indigo-600', 'text-white', 'border-blue-300', 'shadow-[0_4px_0px_#4f46e5]', 'active:translate-y-1');

                        let line = document.getElementById('osNodeLine');
                        line.classList.remove('opacity-0');
                        line.classList.add('opacity-100', 'animate-pulse');

                        document.getElementById('osInstruction').innerHTML = '3. Sambungkan datanya! <span class="text-yellow-400">Klik garis abu-abu</span> di tengah untuk menghubungkan nodes.';
                        osStep = 3;
                    }

                    function osConnect() {
                        if(osStep !== 3) return;
                        
                        let line = document.getElementById('osNodeLine');
                        line.classList.remove('bg-gray-700', 'animate-pulse');
                        line.classList.add('bg-gradient-to-r', 'from-gray-300', 'to-blue-500', 'shadow-[0_0_10px_rgba(59,130,246,0.8)]');
                        document.getElementById('osLineHint').classList.add('hidden');

                        let nodeBox = document.getElementById('osNodeScatter');
                        nodeBox.classList.remove('cursor-default');
                        nodeBox.classList.add('cursor-pointer', 'hover:scale-105', 'ring-4', 'ring-white/50');
                        document.getElementById('osScatterHint').classList.remove('hidden');

                        document.getElementById('osInstruction').innerHTML = '4. Terhubung! <span class="text-green-400">Klik widget Scatter Plot</span> untuk melihat keajaibannya.';
                        osStep = 4;
                    }

                    function osOpenResult() {
                        if(osStep !== 4) return;
                        
                        let modal = document.getElementById('osModal');
                        let modalContent = document.getElementById('osModalContent');
                        
                        // Reset checkbox state
                        document.getElementById('checkColor').checked = false;
                        document.querySelectorAll('.os-dot').forEach(el => {
                            el.classList.remove('bg-red-500', 'bg-green-500', 'bg-blue-500');
                            el.classList.add('bg-gray-500');
                        });
                        document.getElementById('osSuccessMsg').classList.add('hidden');
                        
                        modal.classList.remove('hidden');
                        modal.classList.add('flex');
                        setTimeout(() => {
                            modal.classList.remove('opacity-0');
                            modal.classList.add('opacity-100');
                            modalContent.classList.remove('scale-95');
                            modalContent.classList.add('scale-100');
                        }, 50);

                        document.getElementById('osInstruction').innerHTML = '<span class="text-green-400">🎉 Misi Selesai!</span> Centang fitur Pewarnaan di panel kiri untuk melihat efek Clustering.';
                        osStep = 5;
                    }
                    
                    function osToggleColor() {
                        let isChecked = document.getElementById('checkColor').checked;
                        let dots = document.querySelectorAll('.os-dot');
                        let msg = document.getElementById('osSuccessMsg');
                        
                        if(isChecked) {
                            dots.forEach(el => {
                                el.classList.remove('bg-gray-500');
                                el.classList.add(el.getAttribute('data-color').split('-')[0] + '-' + el.getAttribute('data-color').split('-')[1] + '-' + el.getAttribute('data-color').split('-')[2]);
                            });
                            msg.classList.remove('hidden');
                        } else {
                            dots.forEach(el => {
                                el.classList.remove('bg-red-500', 'bg-green-500', 'bg-blue-500');
                                el.classList.add('bg-gray-500');
                            });
                            msg.classList.add('hidden');
                        }
                    }

                    function osReset() {
                        let modal = document.getElementById('osModal');
                        modal.classList.add('opacity-0');
                        
                        setTimeout(() => {
                            modal.classList.add('hidden');
                            modal.classList.remove('flex');
                        }, 500);
                        
                        document.getElementById('osNodeFile').classList.replace('scale-100', 'scale-0');
                        
                        let nodeBox = document.getElementById('osNodeScatter');
                        nodeBox.classList.replace('scale-100', 'scale-0');
                        nodeBox.classList.remove('cursor-pointer', 'hover:scale-105', 'ring-4', 'ring-white/50');
                        document.getElementById('osScatterHint').classList.add('hidden');

                        let line = document.getElementById('osNodeLine');
                        line.classList.remove('opacity-100', 'bg-gradient-to-r', 'from-gray-300', 'to-blue-500', 'shadow-[0_0_10px_rgba(59,130,246,0.8)]');
                        line.classList.add('opacity-0', 'bg-gray-700');
                        document.getElementById('osLineHint').classList.remove('hidden');

                        let btnFile = document.getElementById('osBtnFile');
                        btnFile.className = "bg-white hover:bg-gray-100 text-black py-2 px-4 rounded-full font-bold text-sm shadow-[0_4px_0px_#cbd5e1] active:shadow-none active:translate-y-1 transition-all flex items-center justify-start gap-3 border-2 border-gray-300";
                        
                        let btnBar = document.getElementById('osBtnScatter');
